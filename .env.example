# Real virtual try-on uses remote GPU inference. It is disabled by default so
# photos are never sent outside localhost without an explicit choice.
AI_PROVIDER=ootdiffusion_gradio
REMOTE_INFERENCE_ENABLED=false
# Set this to your own OOTDiffusion/Gradio deployment for reliable use.
OOTDIFFUSION_URL=https://levihsu-ootdiffusion.hf.space
OOTDIFFUSION_API_NAME=/process_dc
OOTDIFFUSION_STEPS=30
OOTDIFFUSION_GUIDANCE_SCALE=2.0
